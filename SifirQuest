<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sifir Quest - Pengembaraan Matematik</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        playful: {
                            pink: '#ff2e93',
                            purple: '#a855f7',
                            blue: '#06b6d4',
                            yellow: '#eab308',
                            orange: '#f97316',
                        }
                    },
                    fontFamily: {
                        sans: ['Fredoka', 'Nunito', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts: Fredoka & Nunito -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&family=Nunito:wght@400;700;900&display=swap" rel="stylesheet">
    <!-- FontAwesome for Premium Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Fredoka', 'Nunito', sans-serif;
            user-select: none;
            -webkit-user-select: none;
            overflow: hidden;
            background-color: #0f172a;
        }

        /* Portrait Mobile Container Simulator for Desktop view */
        .app-container {
            max-width: 480px;
            height: 100vh;
            margin: 0 auto;
            position: relative;
            background: linear-gradient(135deg, #1e1b4b 0%, #311042 100%);
            box-shadow: 0 0 40px rgba(0,0,0,0.8);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Customizable themes */
        .theme-galaxy {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
        }
        .theme-forest {
            background: linear-gradient(135deg, #022c22 0%, #064e3b 100%);
        }
        .theme-sunset {
            background: linear-gradient(135deg, #451a03 0%, #78350f 100%);
        }

        /* Custom Scrollbar for inner scrolls */
        .custom-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }

        /* Floating effect for maps/avatars */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(2deg); }
        }
        .animate-float {
            animation: float 4s ease-in-out infinite;
        }

        /* Pop effect */
        @keyframes pop {
            0% { transform: scale(0.9); opacity: 0; }
            80% { transform: scale(1.05); }
            100% { transform: scale(1); opacity: 1; }
        }
        .animate-pop {
            animation: pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        /* Confetti or Stars Particle effect */
        .particle {
            position: absolute;
            pointer-events: none;
            animation: particleFall 1.5s ease-out forwards;
        }
        @keyframes particleFall {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(300px) rotate(360deg); opacity: 0; }
        }

        /* Pulse and Glow for Adventure Path Nodes */
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 10px rgba(34, 197, 94, 0.6); }
            50% { box-shadow: 0 0 25px rgba(34, 197, 94, 0.9); }
        }
        .active-node {
            animation: pulseGlow 2s infinite;
        }

        /* Shake animation for wrong answers */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }

        /* Balloon rise animation */
        @keyframes riseUp {
            0% { transform: translateY(400px); opacity: 1; }
            100% { transform: translateY(-200px); opacity: 1; }
        }
        .balloon-animation {
            animation: riseUp 6s linear infinite;
        }

        /* Spin Wheel rotation */
        .spin-transition {
            transition: transform 4s cubic-bezier(0.1, 0.8, 0.1, 1);
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen">

    <div id="app" class="app-container text-white theme-galaxy">
        
        <!-- ==================== STREAK / TOAST / POPUPS (Overlay alerts) ==================== -->
        <div id="toast" class="absolute top-16 left-4 right-4 bg-brand-600 text-white p-4 rounded-2xl shadow-2xl flex items-center gap-3 transform -translate-y-32 opacity-0 transition-all duration-300 z-50">
            <div class="text-2xl"><i class="fas fa-fire text-playful-orange"></i></div>
            <div>
                <h4 id="toast-title" class="font-bold text-sm">Hebat!</h4>
                <p id="toast-msg" class="text-xs">Streak harian anda bertambah!</p>
            </div>
        </div>

        <!-- Dynamic Overlay / Modal Container -->
        <div id="custom-modal" class="absolute inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-6">
            <div class="bg-indigo-900/90 border-4 border-indigo-500 rounded-3xl p-6 text-center max-w-sm w-full animate-pop shadow-2xl">
                <div id="modal-icon" class="text-5xl text-playful-yellow mb-3">
                    <i class="fas fa-trophy"></i>
                </div>
                <h3 id="modal-title" class="text-2xl font-black mb-2 text-playful-yellow">Tahniah!</h3>
                <p id="modal-desc" class="text-sm text-indigo-200 mb-6">Anda telah berjaya menamatkan tugasan ini.</p>
                <button onclick="closeModal()" class="w-full bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-white font-black py-3 px-6 rounded-2xl shadow-lg border-b-4 border-emerald-700 transition">
                    Teruskan
                </button>
            </div>
        </div>

        <!-- ==================== SCREEN: REGISTRATION ==================== -->
        <div id="screen-register" class="flex-1 flex flex-col justify-between p-6 overflow-y-auto custom-scroll">
            <div class="text-center mt-6">
                <div class="text-7xl mb-2 animate-float inline-block">🚀</div>
                <h1 class="text-4xl font-black tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-playful-pink via-purple-400 to-playful-blue">SIFIR QUEST</h1>
                <p class="text-indigo-200 text-sm mt-1" data-key="reg-subtitle">Mulakan Pengembaraan Matematik Premium Anda!</p>
            </div>

            <!-- Form -->
            <div class="bg-indigo-950/70 border-2 border-indigo-800 rounded-3xl p-6 shadow-xl space-y-4 my-6">
                <div>
                    <label class="block text-xs font-bold text-indigo-300 mb-1 uppercase tracking-wider" data-key="reg-name">NAMA PENUH</label>
                    <input type="text" id="reg-input-name" placeholder="cth: Muhammad" class="w-full bg-indigo-900/50 border border-indigo-700 rounded-xl px-4 py-3 text-white placeholder-indigo-500 focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
                </div>
                
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-indigo-300 mb-1 uppercase tracking-wider" data-key="reg-age">UMUR</label>
                        <select id="reg-input-age" class="w-full bg-indigo-900/50 border border-indigo-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
                            <option value="7">7 Tahun</option>
                            <option value="8">8 Tahun</option>
                            <option value="9">9 Tahun</option>
                            <option value="10">10 Tahun</option>
                            <option value="11">11 Tahun</option>
                            <option value="12">12 Tahun</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-indigo-300 mb-1 uppercase tracking-wider" data-key="reg-year">TAHUN/DARJAH</label>
                        <select id="reg-input-year" class="w-full bg-indigo-900/50 border border-indigo-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
                            <option value="1">Darjah 1</option>
                            <option value="2">Darjah 2</option>
                            <option value="3">Darjah 3</option>
                            <option value="4">Darjah 4</option>
                            <option value="5">Darjah 5</option>
                            <option value="6">Darjah 6</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-indigo-300 mb-1 uppercase tracking-wider" data-key="reg-code">KOD AKSES (PILIHAN)</label>
                    <input type="text" id="reg-input-code" placeholder="cth: SCH99" class="w-full bg-indigo-900/50 border border-indigo-700 rounded-xl px-4 py-3 text-white placeholder-indigo-500 focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
                </div>
            </div>

            <!-- Choose Starter Character -->
            <div class="mb-4">
                <p class="text-center text-xs font-bold text-indigo-300 mb-3" data-key="reg-select-char">PILIH HERO PERTAMA ANDA:</p>
                <div class="grid grid-cols-5 gap-2" id="starter-character-list">
                    <!-- Dynamic rendering of starter heroes -->
                </div>
            </div>

            <button onclick="handleRegister()" class="w-full bg-gradient-to-r from-emerald-400 to-green-600 hover:brightness-110 active:scale-95 text-white font-black py-4 rounded-2xl shadow-lg border-b-4 border-emerald-700 transition text-center" data-key="reg-start-btn">
                DAFTAR & MULA BERMAIN!
            </button>
        </div>


        <!-- ==================== HEADER BAR ==================== -->
        <div id="app-header" class="hidden flex items-center justify-between px-4 py-3 bg-indigo-950/80 border-b border-indigo-800 backdrop-blur-md z-30">
            <div class="flex items-center gap-2">
                <img id="header-avatar" src="https://placehold.co/100/purple/white?text=🦸" class="w-9 h-9 rounded-full border-2 border-purple-400 object-cover" onerror="this.src='https://placehold.co/100/purple/white?text=H'">
                <div>
                    <div id="header-username" class="font-black text-xs text-white leading-tight">SifirHero</div>
                    <div class="flex items-center gap-1">
                        <span class="text-[9px] bg-purple-600 text-white px-1.5 py-0.5 rounded-full font-bold">LVL <span id="header-level">1</span></span>
                        <div class="w-16 bg-indigo-900 h-1.5 rounded-full overflow-hidden">
                            <div id="header-xp-bar" class="bg-purple-400 h-full" style="width: 30%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1 bg-indigo-900/60 px-2 py-1 rounded-full border border-indigo-700/50">
                    <span class="text-playful-yellow text-xs"><i class="fas fa-star"></i></span>
                    <span id="header-stars" class="font-black text-xs text-yellow-300">0</span>
                </div>
                <div class="flex items-center gap-1 bg-indigo-900/60 px-2 py-1 rounded-full border border-indigo-700/50">
                    <span class="text-amber-400 text-xs"><i class="fas fa-coins animate-pulse"></i></span>
                    <span id="header-coins" class="font-black text-xs text-amber-300">250</span>
                </div>
                <!-- Dynamic Language Toggle Button -->
                <button onclick="toggleLanguage()" class="bg-indigo-800 text-white font-black text-[10px] py-1 px-2.5 rounded-lg border border-indigo-600 active:scale-95 flex items-center gap-1">
                    <i class="fas fa-globe text-playful-blue"></i> <span id="lang-btn-text">BM</span>
                </button>
            </div>
        </div>


        <!-- ==================== CONTENT SCREEN WRAPPERS ==================== -->
        <div id="app-content" class="hidden flex-1 overflow-y-auto custom-scroll relative">
            
            <!-- SECTION 1: HOME (Adventure Map) -->
            <div id="screen-home" class="p-4 space-y-6">
                <!-- Daily streak / Mission Widget -->
                <div class="bg-gradient-to-r from-purple-900/90 to-indigo-900/90 border-2 border-purple-500 rounded-3xl p-4 shadow-xl flex items-center justify-between">
                    <div>
                        <h3 class="font-black text-sm text-playful-yellow flex items-center gap-1" data-key="streak-banner"><i class="fas fa-fire animate-pulse text-playful-orange"></i> Streak Harian: <span id="home-streak-count">1</span> Hari</h3>
                        <p class="text-xs text-indigo-200 mt-1" data-key="streak-tip">Teruskan bermain esok untuk ganjaran berganda!</p>
                    </div>
                    <button onclick="openSpinWheel()" class="bg-gradient-to-r from-yellow-400 to-amber-500 hover:brightness-110 active:scale-95 text-xs text-indigo-950 font-black px-4 py-2.5 rounded-2xl shadow-lg animate-bounce">
                        <i class="fas fa-dharmachakra"></i> SPIN!
                    </button>
                </div>

                <!-- Daily Mission Mini Tracker -->
                <div class="bg-indigo-950/60 border border-indigo-800 rounded-3xl p-4">
                    <h4 class="font-bold text-xs text-indigo-300 uppercase tracking-widest mb-3 flex items-center justify-between">
                        <span data-key="daily-mission-title">Misi Hari Ini</span>
                        <span class="text-playful-pink text-xs"><i class="fas fa-calendar-day"></i></span>
                    </h4>
                    <div class="space-y-2" id="daily-mission-container">
                        <!-- Dynamic rendering of daily goals -->
                    </div>
                </div>

                <!-- Adventure Map View -->
                <div class="relative bg-black/40 rounded-3xl p-6 border border-indigo-900 overflow-hidden">
                    <div class="absolute inset-0 opacity-10 pointer-events-none bg-repeat" style="background-image: url('https://placehold.co/100');"></div>
                    
                    <div class="relative text-center mb-6">
                        <span class="text-xs font-extrabold tracking-widest text-indigo-400 uppercase" data-key="map-mode">MOD KEMBARA</span>
                        <h2 class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300" data-key="map-title">Peta Pengembaraan Sifir</h2>
                    </div>

                    <!-- Map nodes list inside vertical winding path -->
                    <div class="relative flex flex-col items-center gap-12 py-6" id="adventure-map-container">
                        <!-- Dynamic Levels will be rendered here. Alternating left-center-right nodes -->
                    </div>
                </div>
            </div>


            <!-- SECTION 2: PLAY (Alternative/Special Modes Hub) -->
            <div id="screen-play" class="hidden p-4 space-y-4">
                <div class="text-center mb-4">
                    <h2 class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-yellow-500" data-key="modes-title">Pusat Latihan & Cabaran</h2>
                    <p class="text-xs text-indigo-300" data-key="modes-subtitle">Pilih cara anda mencabar minda sifir anda!</p>
                </div>

                <!-- Custom Sifir Selection Table Grid -->
                <div class="bg-indigo-950/60 border border-indigo-800 rounded-3xl p-4">
                    <h3 class="font-black text-sm text-indigo-200 mb-3" data-key="pilih-sifir-label">Pilih & Latih Sifir Khusus:</h3>
                    <div class="grid grid-cols-4 gap-2">
                        <!-- Sifir buttons 1 to 12 -->
                        <script>
                            for (let i = 1; i <= 12; i++) {
                                document.write(`
                                    <button onclick="startQuickSifir(${i})" class="bg-indigo-900/80 hover:bg-purple-900 border border-indigo-700 hover:border-purple-500 active:scale-95 text-white py-3 rounded-2xl font-black text-sm transition">
                                        × ${i}
                                    </button>
                                `);
                            }
                        </script>
                    </div>
                </div>

                <!-- Speed Challenge Grid Options -->
                <div class="bg-indigo-950/60 border border-indigo-800 rounded-3xl p-4 space-y-3">
                    <h3 class="font-black text-sm text-indigo-200" data-key="speed-header">Cabaran Laju (Speed Challenge):</h3>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="startSpeedChallenge(30)" class="bg-gradient-to-r from-red-500 to-pink-600 active:scale-95 text-white font-bold p-3 rounded-2xl text-xs flex items-center justify-between shadow">
                            <span>⏱️ 30 Saat</span>
                            <i class="fas fa-bolt"></i>
                        </button>
                        <button onclick="startSpeedChallenge(60)" class="bg-gradient-to-r from-red-600 to-orange-600 active:scale-95 text-white font-bold p-3 rounded-2xl text-xs flex items-center justify-between shadow">
                            <span>⏱️ 60 Saat</span>
                            <i class="fas fa-bolt"></i>
                        </button>
                        <button onclick="startSpeedChallenge(120)" class="bg-gradient-to-r from-orange-500 to-yellow-600 active:scale-95 text-white font-bold p-3 rounded-2xl text-xs flex items-center justify-between shadow">
                            <span>⏱️ 120 Saat</span>
                            <i class="fas fa-bolt"></i>
                        </button>
                        <button onclick="startSpeedChallenge(-1)" class="bg-gradient-to-r from-purple-600 to-pink-700 active:scale-95 text-white font-bold p-3 rounded-2xl text-xs flex items-center justify-between shadow">
                            <span data-key="unlimited-mode">🧠 Tanpa Had</span>
                            <i class="fas fa-infinity"></i>
                        </button>
                    </div>
                </div>

                <!-- Boss Encounter Shortcut -->
                <div class="bg-gradient-to-r from-red-950 via-red-900 to-indigo-950 border-2 border-red-700 rounded-3xl p-4 flex items-center justify-between">
                    <div>
                        <span class="text-[9px] bg-red-600 text-white font-extrabold px-2 py-0.5 rounded-full uppercase tracking-wider" data-key="boss-badge">Cabaran Raja</span>
                        <h4 class="font-black text-base text-red-200 mt-1" data-key="boss-shortcut-title">Pertempuran Boss Besar!</h4>
                        <p class="text-xs text-red-300" data-key="boss-shortcut-desc">Uji kehebatan matematik dan kalahkan Raja Sifir.</p>
                    </div>
                    <button onclick="startBossEncounter()" class="bg-gradient-to-r from-red-500 to-rose-600 active:scale-95 text-xs text-white font-black px-4 py-3 rounded-2xl shadow-xl flex items-center gap-1.5 border border-red-400">
                        <i class="fas fa-dragon"></i> SERANG
                    </button>
                </div>

                <!-- Casual Play Mode (Latihan Santai) -->
                <button onclick="startCasualTraining()" class="w-full bg-indigo-900/40 hover:bg-indigo-800/60 border border-indigo-700 rounded-2xl p-4 text-left flex items-center gap-4 active:scale-98 transition">
                    <div class="text-3xl"><i class="fas fa-coffee text-playful-blue"></i></div>
                    <div>
                        <h4 class="font-black text-sm text-white" data-key="casual-title">Latihan Santai</h4>
                        <p class="text-xs text-indigo-300" data-key="casual-desc">Latihan tanpa pemasa dan tekanan. Belajar mengikut kelajuan sendiri.</p>
                    </div>
                </button>
            </div>


            <!-- SECTION 3: REWARDS (Shop, Achievements, Spin Wheel UI) -->
            <div id="screen-rewards" class="hidden p-4 space-y-6">
                <!-- Tab Switching: Shop vs Achievements -->
                <div class="flex bg-indigo-950/80 p-1.5 rounded-2xl border border-indigo-800">
                    <button onclick="toggleRewardTab('shop')" id="reward-tab-shop" class="flex-1 bg-indigo-800 text-white font-black text-xs py-2.5 rounded-xl transition text-center" data-key="tab-shop">
                        Kedai Hero
                    </button>
                    <button onclick="toggleRewardTab('achieve')" id="reward-tab-achieve" class="flex-1 text-indigo-300 font-black text-xs py-2.5 rounded-xl transition text-center" data-key="tab-achieve">
                        Pencapaian
                    </button>
                </div>

                <!-- Rewards Screen content 1: The Premium Shop -->
                <div id="reward-shop-section" class="space-y-4">
                    <div class="flex items-center justify-between">
                        <h3 class="font-black text-sm text-playful-yellow" data-key="shop-title-avatar">Buka Kunci Karakter & Tema:</h3>
                        <span class="text-xs text-indigo-300 flex items-center gap-1"><i class="fas fa-coins text-amber-400"></i> <span id="shop-coin-display">0</span></span>
                    </div>

                    <div class="grid grid-cols-2 gap-3" id="shop-items-grid">
                        <!-- Dynamic shop content loaded via JS -->
                    </div>
                </div>

                <!-- Rewards Screen content 2: Achievements and Badges -->
                <div id="reward-achieve-section" class="hidden space-y-4">
                    <h3 class="font-black text-sm text-playful-pink" data-key="badge-title">Pingat Sifir & Lencana Pencapaian:</h3>
                    <div class="space-y-3" id="achievements-list-container">
                        <!-- Dynamic achievement cards -->
                    </div>
                </div>
            </div>


            <!-- SECTION 4: LEADERBOARD -->
            <div id="screen-leaderboard" class="hidden p-4 space-y-4">
                <div class="text-center">
                    <h2 class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-green-500" data-key="lead-title">Kedudukan Jaguh Sifir</h2>
                    <p class="text-xs text-indigo-300" data-key="lead-subtitle">Siapakah pakar sifir terpantas minggu ini?</p>
                </div>

                <!-- Ranking Types Selector -->
                <div class="flex bg-indigo-950/80 p-1 rounded-2xl border border-indigo-800 text-xs">
                    <button onclick="loadLeaderboard('device')" id="btn-lead-device" class="flex-1 bg-indigo-800 text-white font-black py-2 rounded-xl transition">Peranti</button>
                    <button onclick="loadLeaderboard('school')" id="btn-lead-school" class="flex-1 text-indigo-300 font-bold py-2 rounded-xl transition">Sekolah</button>
                    <button onclick="loadLeaderboard('global')" id="btn-lead-global" class="flex-1 text-indigo-300 font-bold py-2 rounded-xl transition">Global</button>
                </div>

                <!-- The Podiums for Top 3 -->
                <div class="grid grid-cols-3 gap-2 items-end pt-6 pb-2" id="leaderboard-podium">
                    <!-- Dynamic Top 3 placement podium layout -->
                </div>

                <!-- Leaderboard Rank List -->
                <div class="bg-indigo-950/60 border border-indigo-800 rounded-3xl p-3 space-y-2" id="leaderboard-list">
                    <!-- Dynamic list items -->
                </div>
            </div>


            <!-- SECTION 5: PROFILE (User info, Parent Analytics, Milestones Certificate, Settings) -->
            <div id="screen-profile" class="hidden p-4 space-y-6">
                <!-- Simple Profile Info -->
                <div class="bg-indigo-950/60 border border-indigo-800 rounded-3xl p-4 flex items-center gap-4">
                    <img id="profile-pic" src="https://placehold.co/100/purple/white?text=🦸" class="w-16 h-16 rounded-3xl border-2 border-purple-500 object-cover" onerror="this.src='https://placehold.co/100/purple/white?text=P'">
                    <div class="flex-1">
                        <h3 id="profile-name" class="text-lg font-black text-white">Adli</h3>
                        <p class="text-xs text-indigo-300"><span data-key="age-label">Umur</span>: <span id="profile-age">9</span> | <span data-key="year-label">Darjah</span>: <span id="profile-year">3</span></p>
                        <div class="mt-2 flex items-center gap-2">
                            <span class="text-[10px] bg-indigo-800 text-indigo-200 border border-indigo-700 px-2 py-0.5 rounded-full font-bold">Code: <span id="profile-code">SCH99</span></span>
                        </div>
                    </div>
