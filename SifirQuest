                        </div>
                        ${isUnlocked ? 
                            `<button onclick="setActiveHero('${key}')" class="w-full ${isActive ? 'bg-indigo-950 border-indigo-800 text-indigo-500' : 'bg-purple-600 hover:bg-purple-700'} text-white text-[10px] font-black py-1.5 rounded-xl transition">${isActive ? 'ACTIVE' : 'SELECT'}</button>` :
                            `<button onclick="buyHero('${key}', ${h.price})" class="w-full bg-amber-500 hover:bg-amber-600 text-indigo-950 text-[10px] font-black py-1.5 rounded-xl transition">BUY CHARACTER</button>`
