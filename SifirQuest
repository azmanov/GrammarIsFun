                        </div>
                        <div class="w-full bg-indigo-950 h-3 rounded-full overflow-hidden border border-indigo-800">
                            <div class="bg-gradient-to-r from-emerald-500 to-teal-400 h-full transition-all duration-300" style="width: ${playerPercent}%;"></div>
                        </div>
                    </div>
                `;
            }

            switch(type) {
                case 1: // Multiple Choice
                    renderMCQ(workspace, questionText);
                    break;
                case 2: // Drag and drop simulation (Optimized click-placement for mobile)
                    renderDragDropSimulation(workspace);
                    break;
                case 3: // Fill in the blank
