        // Sound Synthesis Manager using Web Audio API
        const SoundManager = {
            ctx: null,
            enabled: true,
            musicOn: true,
            musicNode: null,

            init() {
                try {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                } catch (e) {
                    console.error("Audio Context not supported", e);
                }
            },

            playClick() {
                if (!this.enabled || !this.ctx) return;
                this.ctx.resume();
                let osc = this.ctx.createOscillator();
                let gain = this.ctx.createGain();
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.frequency.setValueAtTime(300, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(600, this.ctx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.1, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.08);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.08);
            },

            playCorrect() {
                if (!this.enabled || !this.ctx) return;
                this.ctx.resume();
                let now = this.ctx.currentTime;
                let osc = this.ctx.createOscillator();
                let gain = this.ctx.createGain();
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.frequency.setValueAtTime(523.25, now); // C5
                osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
                osc.frequency.setValueAtTime(783.99, now + 0.2); // G5
                osc.frequency.setValueAtTime(1046.50, now + 0.3); // C6
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
                osc.start();
                osc.stop(now + 0.5);
            },

            playWrong() {
                if (!this.enabled || !this.ctx) return;
                this.ctx.resume();
                let now = this.ctx.currentTime;
                let osc = this.ctx.createOscillator();
                let gain = this.ctx.createGain();
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.frequency.setValueAtTime(220, now); // A3
                osc.frequency.linearRampToValueAtTime(110, now + 0.3); // A2
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                osc.start();
                osc.stop(now + 0.3);
            },

            playWin() {
                if (!this.enabled || !this.ctx) return;
                this.ctx.resume();
                let now = this.ctx.currentTime;
                // Quick victory fanfare
                [0, 0.12, 0.24, 0.36].forEach((delay, idx) => {
                    let osc = this.ctx.createOscillator();
                    let gain = this.ctx.createGain();
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    let freqs = [523.25, 659.25, 783.99, 1046.50];
                    osc.frequency.setValueAtTime(freqs[idx], now + delay);
                    gain.gain.setValueAtTime(0.1, now + delay);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + delay + 0.25);
                    osc.start(now + delay);
                    osc.stop(now + delay + 0.25);
                });
            },

            startMusic() {
                // Synthesizes a subtle looped background pad or simple beep melody
                if (!this.musicOn || !this.ctx) return;
                try {
                    this.ctx.resume();
                    // We only build a basic loop to avoid clogging AudioNodes
                    this.musicNode = this.ctx.createOscillator();
                    let gain = this.ctx.createGain();
                    this.musicNode.connect(gain);
                    gain.connect(this.ctx.destination);
                    this.musicNode.type = 'triangle';
                    this.musicNode.frequency.setValueAtTime(150, this.ctx.currentTime);
                    gain.gain.setValueAtTime(0.02, this.ctx.currentTime);
                    this.musicNode.start();
                } catch(e){}
            },

            stopMusic() {
                if (this.musicNode) {
                    try { this.musicNode.stop(); } catch(e){}
                    this.musicNode = null;
                }
            }
        };

