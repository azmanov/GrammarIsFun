        function drawWheel() {
            let container = document.getElementById('wheel-wedges');
            container.innerHTML = "";
            let degSlice = 360 / WHEEL_ITEMS.length;

            WHEEL_ITEMS.forEach((item, index) => {
                let rot = index * degSlice;
                // Draw simple styled wedges inside SVG or pure transforms
                container.innerHTML += `
                    <div class="absolute inset-0 flex items-center justify-center font-black text-[11px]" style="transform: rotate(${rot}deg); transform-origin: 50% 50%;">
                        <span class="absolute" style="transform: translateY(-90px);">${item.label}</span>
                    </div>
                `;
            });
        }

        let isSpinning = false;
        function spinTheWheel() {
            if (isSpinning) return;
            SoundManager.playClick();
            isSpinning = true;

            // Trigger random wedge stop
            let targetIdx = Math.floor(Math.random() * WHEEL_ITEMS.length);
            let degreePerSlice = 360 / WHEEL_ITEMS.length;
            
            // Total spins + destination slice
            let extraSpins = 5 * 360;
            let destDeg = extraSpins + (targetIdx * degreePerSlice);

            const wheel = document.getElementById('wheel');
            wheel.style.transform = `rotate(-${destDeg}deg)`;

            setTimeout(() => {
                isSpinning = false;
                let wonItem = WHEEL_ITEMS[targetIdx];
                
                // Reward Player
                if (wonItem.type === 'coins') {
                    addCoins(wonItem.amount);
                } else if (wonItem.type === 'stars') {
                    state.stats.stars += wonItem.amount;
                } else if (wonItem.type === 'xp') {
                    addXP(wonItem.amount);
                }
                
                saveStateToStorage();
                updateTopHUD();
                SoundManager.playWin();

                showModal("<i class='fas fa-gift text-amber-500 animate-bounce'></i>", 
