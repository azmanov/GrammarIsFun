            SoundManager.playClick();
            // Hide all screens
            document.getElementById('screen-home').classList.add('hidden');
            document.getElementById('screen-play').classList.add('hidden');
            document.getElementById('screen-rewards').classList.add('hidden');
            document.getElementById('screen-leaderboard').classList.add('hidden');
            document.getElementById('screen-profile').classList.add('hidden');

            // Show target
            document.getElementById(`screen-${tabId}`).classList.remove('hidden');

            // Reset Tab styling in bottom nav
            ['home', 'play', 'rewards', 'leaderboard', 'profile'].forEach(tab => {
                let btn = document.getElementById(`nav-${tab}`);
                if (tab === tabId) {
                    btn.classList.add('text-emerald-400');
                    btn.classList.remove('text-indigo-400');
                } else {
                    btn.classList.add('text-indigo-400');
                    btn.classList.remove('text-emerald-400');
                }
            });

            // Extra lazy loaded setups
            if (tabId === 'rewards') {
                renderShopItems();
