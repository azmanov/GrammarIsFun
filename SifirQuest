        // Local Storage Helper
        function saveStateToStorage() {
            localStorage.setItem('sifir_quest_state', JSON.stringify(state));
        }

        function loadStateFromStorage() {
            let data = localStorage.getItem('sifir_quest_state');
            if (data) {
                state = JSON.parse(data);
                return true;
            }
            return false;
        }

        // Translation application helper
        function applyTranslations() {
            const lang = state.currentLanguage;
            document.querySelectorAll('[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if (DICTIONARY[lang] && DICTIONARY[lang][key]) {
                    el.innerText = DICTIONARY[lang][key];
                }
            });
            document.getElementById('lang-btn-text').innerText = lang.toUpperCase();
        }

        function toggleLanguage() {
            state.currentLanguage = (state.currentLanguage === 'bm') ? 'en' : 'bm';
            saveStateToStorage();
            applyTranslations();
            renderDailyMissions();
            renderAdventureMap();
        }

        // Notification / Toast helper
        function showToast(title, msg, isSuccess = true) {
            SoundManager.playClick();
            const toast = document.getElementById('toast');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-msg').innerText = msg;
            
            toast.className = `absolute top-16 left-4 right-4 ${isSuccess ? 'bg-emerald-600' : 'bg-red-600'} text-white p-4 rounded-2xl shadow-2xl flex items-center gap-3 transform translate-y-0 opacity-100 transition-all duration-300 z-50`;
            
            setTimeout(() => {
                toast.className = `absolute top-16 left-4 right-4 ${isSuccess ? 'bg-emerald-600' : 'bg-red-600'} text-white p-4 rounded-2xl shadow-2xl flex items-center gap-3 transform -translate-y-32 opacity-0 transition-all duration-300 z-50`;
            }, 3000);
        }

        // Custom modal helper
        function showModal(icon, title, desc) {
            document.getElementById('modal-icon').innerHTML = icon;
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-desc').innerText = desc;
            document.getElementById('custom-modal').classList.remove('hidden');
        }

        function closeModal() {
            SoundManager.playClick();
            document.getElementById('custom-modal').classList.add('hidden');
        }

        window.onload = function() {
            SoundManager.init();
            
            // Check if profile is already configured
            const hasData = loadStateFromStorage();
            
            // Sync Settings UI
            document.getElementById('btn-toggle-music').innerText = SoundManager.musicOn ? 'ON' : 'OFF';
            document.getElementById('btn-toggle-sfx').innerText = SoundManager.enabled ? 'ON' : 'OFF';

            if (hasData && state.user) {
                // Instantly load dashboard
                document.getElementById('screen-register').classList.add('hidden');
                document.getElementById('app-header').classList.remove('hidden');
                document.getElementById('app-content').classList.remove('hidden');
                document.getElementById('app-nav').classList.remove('hidden');
                
                // Set theme
                updateThemeCSS();
                
                // Refresh Top HUD & elements
                updateTopHUD();
                renderAdventureMap();
                renderDailyMissions();
                checkStreakBonus();
                
                // Track time played
                startPlaytimeTracker();
            } else {
                // Initialize starter character options
                renderStarterHeroes();
            }
            
            applyTranslations();
        };

        // Playtime analytic tracker
        let playtimerInterval = null;
        function startPlaytimeTracker() {
            if (playtimerInterval) clearInterval(playtimerInterval);
            playtimerInterval = setInterval(() => {
                state.stats.playTimeTotal++;
                if (state.stats.playTimeTotal % 10 === 0) {
                    saveStateToStorage();
                }
            }, 1000);
        }

        function checkStreakBonus() {
            let today = new Date().toDateString();
            if (state.stats.lastPlayDate !== today) {
                if (state.stats.lastPlayDate) {
                    let lastDate = new Date(state.stats.lastPlayDate);
                    let diffTime = Math.abs(new Date() - lastDate);
                    let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                    if (diffDays === 1) {
                        state.stats.streak++;
                    } else if (diffDays > 1) {
                        state.stats.streak = 1; // reset streak
                    }
                } else {
                    state.stats.streak = 1;
                }
                state.stats.lastPlayDate = today;
                saveStateToStorage();
                setTimeout(() => {
                    showToast("STREAK!", state.currentLanguage === 'bm' ? `Tahniah! Streak harian ke-${state.stats.streak}!` : `Congrats! Daily streak day ${state.stats.streak}!`);
                }, 1000);
            }
        }

        function updateThemeCSS() {
            const container = document.getElementById('app');
            // Remove previous themes
            container.classList.remove('theme-galaxy', 'theme-forest', 'theme-sunset');
            // Apply current theme style class
            let themeClass = THEMES_ASSETS[state.activeTheme]?.css || 'theme-galaxy';
            container.classList.add(themeClass);
        }

        function updateTopHUD() {
            if (!state.user) return;
            document.getElementById('header-username').innerText = state.user.name;
            document.getElementById('header-level').innerText = state.stats.level;
            document.getElementById('header-stars').innerText = state.stats.stars;
            document.getElementById('header-coins').innerText = state.stats.coins;
            
            // XP progress calculation (each level is level * 100 XP)
            let xpNeeded = state.stats.level * 100;
            let percent = (state.stats.xp / xpNeeded) * 100;
            document.getElementById('header-xp-bar').style.width = `${percent}%`;

            // Sync images
            let activeHeroObj = HERO_ASSETS[state.activeHero];
            let placeholderImg = `https://placehold.co/100/purple/white?text=${activeHeroObj ? activeHeroObj.emoji : '🧙'}`;
            document.getElementById('header-avatar').src = placeholderImg;
            document.getElementById('profile-pic').src = placeholderImg;
        }

        let selectedStarterHero = 'wizard';
        function renderStarterHeroes() {
            let container = document.getElementById('starter-character-list');
            container.innerHTML = "";
            Object.keys(HERO_ASSETS).forEach(key => {
                let h = HERO_ASSETS[key];
                if (h.price === 0) {
                    let isSelected = selectedStarterHero === key;
                    container.innerHTML += `
                        <button onclick="selectStarterHero('${key}')" class="flex flex-col items-center justify-center p-2 rounded-2xl border-2 transition ${isSelected ? 'border-purple-400 bg-purple-950/40 scale-105' : 'border-indigo-800 bg-indigo-950/20'}">
                            <span class="text-3xl">${h.emoji}</span>
                            <span class="text-[9px] mt-1 font-bold truncate w-full text-center">${h.name}</span>
                        </button>
                    `;
                }
            });
        }

        function selectStarterHero(key) {
            SoundManager.playClick();
            selectedStarterHero = key;
            renderStarterHeroes();
        }

        // Registration form handle
        function handleRegister() {
            SoundManager.playClick();
            let name = document.getElementById('reg-input-name').value.trim();
            let age = document.getElementById('reg-input-age').value;
            let year = document.getElementById('reg-input-year').value;
            let code = document.getElementById('reg-input-code').value.trim() || 'FREE';

            if (!name) {
                showToast("Ops!", state.currentLanguage === 'bm' ? "Sila masukkan nama penuh anda." : "Please enter your full name.", false);
                return;
            }

            state.user = { name, age, year, code };
            state.activeHero = selectedStarterHero;
            if (!state.unlockedHeroes.includes(selectedStarterHero)) {
                state.unlockedHeroes.push(selectedStarterHero);
            }
            state.stats.lastPlayDate = new Date().toDateString();

            saveStateToStorage();
            
            // Switch Screens
            document.getElementById('screen-register').classList.add('hidden');
            document.getElementById('app-header').classList.remove('hidden');
            document.getElementById('app-content').classList.remove('hidden');
            document.getElementById('app-nav').classList.remove('hidden');
            
            SoundManager.startMusic();
            updateTopHUD();
            renderAdventureMap();
            renderDailyMissions();
            startPlaytimeTracker();

            showToast("Sifir Quest", state.currentLanguage === 'bm' ? "Selamat datang ke dunia sifir!" : "Welcome to the multiplication world!");
        }

        function renderAdventureMap() {
            const container = document.getElementById('adventure-map-container');
            container.innerHTML = "";

            // We generate 12 levels representing Sifir 1 to 12
            // Node layouts winding: Alternating offset styles (left, center, right)
            const mapWinds = ['items-start pl-8', 'items-center', 'items-end pr-8', 'items-center'];
            
            for (let i = 1; i <= 12; i++) {
                let windClass = mapWinds[(i - 1) % 4];
                let isLocked = i > state.adventureStage;
                let isActive = i === state.adventureStage;
                
                let isBoss = i === 6 || i === 12;
                let nodeColor = "bg-indigo-800 border-indigo-600";
                let emoji = "⭐️";

                if (isBoss) {
                    nodeColor = "bg-rose-900 border-rose-600";
                    emoji = "👹";
                } else if (isActive) {
                    nodeColor = "bg-emerald-500 border-emerald-400 active-node";
                } else if (!isLocked) {
                    nodeColor = "bg-purple-600 border-purple-400";
                }

                container.innerHTML += `
                    <div class="flex flex-col ${windClass} w-full transition duration-300">
                        <button onclick="startAdventureStage(${i}, ${isLocked})" class="w-16 h-16 rounded-full flex flex-col items-center justify-center font-black text-white border-4 shadow-xl active:scale-90 transition ${nodeColor} ${isLocked ? 'opacity-40 cursor-not-allowed' : ''}">
                            <span class="text-xl">${isLocked ? '🔒' : emoji}</span>
                            <span class="text-[10px] uppercase font-black">${isBoss ? 'BOSS' : 'LVL ' + i}</span>
                        </button>
                        <span class="text-xs font-bold text-indigo-300 mt-1">${state.currentLanguage === 'bm' ? 'Sifir' : 'Table'} ${i}</span>
                    </div>
                `;
            }
        }

        // Daily mission renderer
        function renderDailyMissions() {
            let container = document.getElementById('daily-mission-container');
            container.innerHTML = "";

            state.dailyMissions.forEach(m => {
                let desc = state.currentLanguage === 'bm' ? m.desc_bm : m.desc_en;
                let isCompleted = m.current >= m.target;
                let percent = Math.min((m.current / m.target) * 100, 100);

                container.innerHTML += `
                    <div class="bg-indigo-900/40 p-3 rounded-2xl border border-indigo-800/60 space-y-2">
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-bold text-indigo-200">${desc}</span>
                            <span class="text-[10px] text-indigo-400 font-extrabold">${m.current}/${m.target}</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="flex-1 bg-indigo-950 h-2 rounded-full overflow-hidden">
                                <div class="bg-gradient-to-r from-emerald-400 to-green-500 h-full" style="width: ${percent}%;"></div>
                            </div>
                            ${isCompleted && !m.rewarded ? 
                                `<button onclick="claimMissionReward('${m.id}')" class="bg-playful-yellow text-indigo-950 font-black text-[10px] px-2 py-1 rounded-xl shadow animate-bounce">CLAIM</button>` : 
                                m.rewarded ? `<span class="text-emerald-400 text-xs"><i class="fas fa-check-circle"></i></span>` : `<span class="text-[10px] text-amber-400 font-bold"><i class="fas fa-coins"></i> +${m.reward}</span>`
                            }
                        </div>
                    </div>
                `;
            });
        }

        function claimMissionReward(id) {
            let m = state.dailyMissions.find(x => x.id === id);
            if (m && m.current >= m.target && !m.rewarded) {
                m.rewarded = true;
                addCoins(m.reward);
                addXP(50);
                saveStateToStorage();
                renderDailyMissions();
                showToast("Mission Claimed!", state.currentLanguage === 'bm' ? `Tahniah! Anda dapat +${m.reward} Syiling!` : `Congrats! You got +${m.reward} Coins!`);
            }
        }

        // Add game progress helpers
        function addCoins(amount) {
            state.stats.coins += amount;
            updateTopHUD();
            saveStateToStorage();
        }

        function addXP(amount) {
            state.stats.xp += amount;
            let xpNeeded = state.stats.level * 100;
            if (state.stats.xp >= xpNeeded) {
                state.stats.xp -= xpNeeded;
                state.stats.level++;
                SoundManager.playWin();
                setTimeout(() => {
                    showModal("<i class='fas fa-arrow-up text-playful-pink'></i>", 
                        state.currentLanguage === 'bm' ? "TAHNIAH! UP LEVEL!" : "CONGRATS! LEVEL UP!", 
                        state.currentLanguage === 'bm' ? `Anda kini Level ${state.stats.level}!` : `You are now Level ${state.stats.level}!`);
                }, 500);
            }
            updateTopHUD();
            saveStateToStorage();
        }

        // Tab Switcher Bottom Nav
