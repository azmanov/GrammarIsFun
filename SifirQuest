                // Prepend Boss visual
                let bossPercent = (bossHPCurrent / bossHPMax) * 100;
                let playerPercent = (playerHPCurrent / playerHPMax) * 100;

                workspace.innerHTML += `
                    <div class="mb-6 space-y-4">
                        <!-- Boss HP -->
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-extrabold text-red-400">👹 RAJA SIFIR SURI</span>
