                state.stats.coins -= price;
                state.unlockedHeroes.push(key);
                state.activeHero = key;
                saveStateToStorage();
                updateTopHUD();
                renderShopItems();
                showToast("Hero Unlocked!", `${HERO_ASSETS[key].name} joined your quest!`);
