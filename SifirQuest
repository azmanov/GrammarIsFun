            let inputNum = parseInt(currentBlankVal);
            checkSelectedAnswer(inputNum, null, correctVal);
            currentBlankVal = ""; // reset for next question
        }

        // Match the Pair mode
        function renderMatchThePair(workspace) {
            let qList = [
                { id: 1, text: `${currentQuestionObj.base} × ${currentQuestionObj.multiplier}`, val: currentQuestionObj.product },
                { id: 2, text: `${currentQuestionObj.base} × 2`, val: currentQuestionObj.base * 2 },
                { id: 3, text: `${currentQuestionObj.base} × 5`, val: currentQuestionObj.base * 5 }
            ];
            
            let answers = qList.map(q => q.val).sort(() => Math.random() - 0.5);

            workspace.innerHTML += `
                <div class="text-center mb-6">
                    <span class="text-sm font-bold text-indigo-400 uppercase tracking-widest">${state.currentLanguage === 'bm' ? 'Padankan Kiri & Kanan' : 'Match Left & Right'}</span>
                </div>

                <div class="grid grid-cols-2 gap-4 max-w-sm mx-auto w-full">
                    <!-- Left Column: Questions -->
                    <div class="space-y-3" id="match-col-questions">
                        ${qList.map(q => `
                            <button onclick="selectMatchPair('q', ${q.val}, this)" class="w-full bg-indigo-900/60 border-2 border-indigo-700 text-xs font-black p-4 rounded-2xl transition text-center hover:border-purple-400">
                                ${q.text}
                            </button>
                        `).join('')}
                    </div>

                    <!-- Right Column: Answers -->
                    <div class="space-y-3" id="match-col-answers">
                        ${answers.map(ans => `
                            <button onclick="selectMatchPair('a', ${ans}, this)" class="w-full bg-indigo-900/60 border-2 border-indigo-700 text-sm font-black p-4 rounded-2xl transition text-center hover:border-purple-400">
                                ${ans}
                            </button>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        let selectedMatchQ = null;
        let selectedMatchA = null;
        let selectedMatchQElem = null;
        let selectedMatchAElem = null;
        let pairedCount = 0;

        function selectMatchPair(type, val, elem) {
            SoundManager.playClick();
            if (type === 'q') {
                if (selectedMatchQElem) selectedMatchQElem.classList.remove('border-purple-400', 'bg-purple-900/40');
                selectedMatchQ = val;
                selectedMatchQElem = elem;
                elem.classList.add('border-purple-400', 'bg-purple-900/40');
            } else {
                if (selectedMatchAElem) selectedMatchAElem.classList.remove('border-purple-400', 'bg-purple-900/40');
                selectedMatchA = val;
                selectedMatchAElem = elem;
                elem.classList.add('border-purple-400', 'bg-purple-900/40');
            }

            // Check if match is found
            if (selectedMatchQ !== null && selectedMatchA !== null) {
                if (selectedMatchQ === selectedMatchA) {
                    // Correct Match
                    SoundManager.playCorrect();
                    selectedMatchQElem.className = "w-full bg-emerald-950/60 border-2 border-emerald-500 text-xs font-black p-4 rounded-2xl text-emerald-300 pointer-events-none";
                    selectedMatchAElem.className = "w-full bg-emerald-950/60 border-2 border-emerald-500 text-sm font-black p-4 rounded-2xl text-emerald-300 pointer-events-none";
                    pairedCount++;

                    selectedMatchQ = null;
                    selectedMatchA = null;
                    selectedMatchQElem = null;
                    selectedMatchAElem = null;

                    if (pairedCount >= 3) {
                        pairedCount = 0; // reset
                        // Successfully completed whole match task
                        setTimeout(() => {
                            checkSelectedAnswer(currentQuestionObj.product, null, currentQuestionObj.product);
                        }, 500);
                    }
                } else {
                    // Wrong Match
                    SoundManager.playWrong();
                    selectedMatchQElem.classList.add('animate-shake', 'border-red-500');
                    selectedMatchAElem.classList.add('animate-shake', 'border-red-500');
                    
                    let qTemp = selectedMatchQElem;
                    let aTemp = selectedMatchAElem;
                    setTimeout(() => {
                        qTemp.classList.remove('animate-shake', 'border-red-500', 'border-purple-400', 'bg-purple-900/40');
                        aTemp.classList.remove('animate-shake', 'border-red-500', 'border-purple-400', 'bg-purple-900/40');
                    }, 500);

                    selectedMatchQ = null;
                    selectedMatchA = null;
                    selectedMatchQElem = null;
                    selectedMatchAElem = null;
                }
            }
        }

        // Balloon Pop Mode
        function renderBalloonPop(workspace) {
            let correctAns = currentQuestionObj.product;
            let options = generateWrongAnswers(correctAns).slice(0, 2);
            options.push(correctAns);
            options.sort(() => Math.random() - 0.5);

            workspace.innerHTML += `
                <div class="text-center mb-4">
                    <span class="text-sm font-bold text-indigo-400 uppercase tracking-widest">${state.currentLanguage === 'bm' ? 'Letupkan Belon Jawapan' : 'Pop the Correct Balloon'}</span>
                    <h1 class="text-4xl font-black text-white mt-2">${currentQuestionObj.base} × ${currentQuestionObj.multiplier} = ?</h1>
                </div>

                <!-- Floating Canvas Container -->
                <div class="relative w-full h-72 bg-indigo-950/40 border border-indigo-900 rounded-3xl overflow-hidden" id="balloon-floating-container">
                    <!-- Balloons rendered as moving up absolute div tags -->
                </div>
            `;

            // Append floating balloons
            const container = document.getElementById('balloon-floating-container');
            const balloonColors = ['bg-playful-pink', 'bg-playful-blue', 'bg-playful-purple'];

            options.forEach((opt, idx) => {
                let col = balloonColors[idx % balloonColors.length];
                let leftPos = 15 + (idx * 30); // distribute across screen width %
                let delay = idx * 1.5;

                container.innerHTML += `
                    <div onclick="popBalloon(${opt}, this)" class="absolute balloon-animation text-center cursor-pointer flex flex-col items-center justify-center transition hover:scale-105" style="left: ${leftPos}%; animation-delay: ${delay}s; top: 0;">
                        <div class="w-16 h-20 ${col} rounded-full flex items-center justify-center font-black text-lg text-white shadow-lg relative">
                            ${opt}
                            <!-- Balloon knot representation -->
                            <div class="absolute bottom-[-4px] left-1/2 transform -translate-x-1/2 w-2 h-2 ${col} rotate-45"></div>
                        </div>
                        <div class="w-0.5 h-12 bg-indigo-700 mt-1"></div>
                    </div>
                `;
            });
        }

        function popBalloon(ans, elem) {
            // Trigger beautiful particle visual pop
            SoundManager.playClick();
            elem.style.transform = 'scale(1.4)';
            elem.style.opacity = '0';
            setTimeout(() => {
                checkSelectedAnswer(ans);
            }, 300);
        }

        // Memory Card Game
        function renderMemoryCardGame(workspace) {
            let list = [
                { id: 1, text: `${currentQuestionObj.base}×${currentQuestionObj.multiplier}`, matchId: 'm1' },
                { id: 2, text: `${currentQuestionObj.product}`, matchId: 'm1' },
                { id: 3, text: `${currentQuestionObj.base}×2`, matchId: 'm2' },
                { id: 4, text: `${currentQuestionObj.base * 2}`, matchId: 'm2' }
            ];
            
            list.sort(() => Math.random() - 0.5);

            workspace.innerHTML += `
                <div class="text-center mb-6">
                    <span class="text-sm font-bold text-indigo-400 uppercase tracking-widest">${state.currentLanguage === 'bm' ? 'Padankan Kad Sifir' : 'Memory Card Match'}</span>
                </div>

                <div class="grid grid-cols-2 gap-3 max-w-xs mx-auto w-full" id="memory-cards-grid">
                    ${list.map(card => `
                        <div onclick="flipMemoryCard('${card.matchId}', this)" class="w-full h-24 bg-indigo-900 hover:bg-purple-900 border-2 border-indigo-700/80 rounded-2xl flex items-center justify-center font-black cursor-pointer text-indigo-300 transition select-none text-xs" data-match="${card.matchId}" data-flipped="false">
                            <span class="hidden card-content">${card.text}</span>
                            <span class="card-question-mark text-lg">❓</span>
                        </div>
                    `).join('')}
                </div>
            `;
        }

        let firstFlippedCard = null;
        let memoryMatchesLeft = 2;

        function flipMemoryCard(matchId, cardElem) {
            if (cardElem.getAttribute('data-flipped') === 'true' || (firstFlippedCard && firstFlippedCard === cardElem)) return;
            SoundManager.playClick();
            
            // Uncover content
            cardElem.setAttribute('data-flipped', 'true');
            cardElem.classList.remove('bg-indigo-900', 'text-indigo-300');
            cardElem.classList.add('bg-purple-950', 'text-white', 'border-purple-400');
            cardElem.querySelector('.card-content').classList.remove('hidden');
            cardElem.querySelector('.card-question-mark').classList.add('hidden');

            if (!firstFlippedCard) {
                firstFlippedCard = cardElem;
            } else {
                let firstMatchId = firstFlippedCard.getAttribute('data-match');
                let secondMatchId = cardElem.getAttribute('data-match');

                if (firstMatchId === secondMatchId) {
                    // Match Success!
                    SoundManager.playCorrect();
                    firstFlippedCard.className = "w-full h-24 bg-emerald-950/60 border-2 border-emerald-500 rounded-2xl flex items-center justify-center font-black text-emerald-400 text-xs pointer-events-none";
                    cardElem.className = "w-full h-24 bg-emerald-950/60 border-2 border-emerald-500 rounded-2xl flex items-center justify-center font-black text-emerald-400 text-xs pointer-events-none";
                    
                    firstFlippedCard = null;
                    memoryMatchesLeft--;

                    if (memoryMatchesLeft <= 0) {
                        memoryMatchesLeft = 2; // reset
                        setTimeout(() => {
                            checkSelectedAnswer(currentQuestionObj.product, null, currentQuestionObj.product);
                        }, 600);
                    }
                } else {
                    // Match Failed
                    SoundManager.playWrong();
                    let fCard = firstFlippedCard;
                    firstFlippedCard = null;

                    setTimeout(() => {
                        // Reset flip animations
                        [fCard, cardElem].forEach(c => {
                            c.setAttribute('data-flipped', 'false');
                            c.className = "w-full h-24 bg-indigo-900 hover:bg-purple-900 border-2 border-indigo-700/80 rounded-2xl flex items-center justify-center font-black cursor-pointer text-indigo-300 transition select-none text-xs";
                            c.querySelector('.card-content').classList.add('hidden');
                            c.querySelector('.card-question-mark').classList.remove('hidden');
                        });
                    }, 1000);
                }
            }
        }

        // Wrong Answer Pool Generator
        function generateWrongAnswers(correctAns) {
            let pool = new Set();
            while (pool.size < 3) {
                let variance = Math.floor(Math.random() * 15) - 7;
                let candidate = correctAns + variance;
                if (candidate > 0 && candidate !== correctAns) {
                    pool.add(candidate);
                }
            }
            return Array.from(pool);
        }

        function checkSelectedAnswer(chosen, elemBtn = null, forcedCorrectVal = null) {
            let correctAns = forcedCorrectVal !== null ? forcedCorrectVal : currentQuestionObj.product;
            let isCorrect = chosen === correctAns;

            // Log performance analytic data
            state.stats.answeredTotal++;
            let tableKey = currentQuestionObj.base;
            if (!state.stats.tableScores[tableKey]) {
                state.stats.tableScores[tableKey] = { correct: 0, total: 0 };
            }
            state.stats.tableScores[tableKey].total++;

            if (isCorrect) {
                correctCountThisSession++;
                state.stats.correctTotal++;
                state.stats.tableScores[tableKey].correct++;
                consecutivePerfectCount++;

                // Daily missions incremental update
                state.dailyMissions.find(m => m.type === 'ans').current++;
                let perfMission = state.dailyMissions.find(m => m.type === 'perf');
                if (consecutivePerfectCount > perfMission.current) {
                    perfMission.current = consecutivePerfectCount;
                }

                SoundManager.playCorrect();
                if (elemBtn) {
                    elemBtn.className = "bg-emerald-600 border-2 border-emerald-400 text-white font-black text-xl py-5 px-4 rounded-3xl transition shadow-lg text-center animate-pop";
                }
                showFeedbackPanel(true);
            } else {
                consecutivePerfectCount = 0; // reset perfect streak
                SoundManager.playWrong();
                if (elemBtn) {
                    elemBtn.classList.add('animate-shake', 'border-red-500', 'bg-red-950');
                }
                showFeedbackPanel(false, correctAns);
            }

            saveStateToStorage();
        }

        function showFeedbackPanel(isCorrect, rightAns = 0) {
            const footer = document.getElementById('gameplay-footer-action');
            
            // Render beautiful floating particles over correct choices
            if (isCorrect) {
                triggerParticles();
            }

            // Perform Boss action calculation if mode active
            if (activeGameMode === "boss") {
                if (isCorrect) {
                    bossHPCurrent -= 10;
                    if (bossHPCurrent <= 0) {
                        bossHPCurrent = 0;
                        setTimeout(() => {
                            finishGameplaySession();
                        }, 500);
                        return;
                    }
                } else {
                    playerHPCurrent--;
                    if (playerHPCurrent <= 0) {
                        playerHPCurrent = 0;
                        setTimeout(() => {
                            finishGameplaySession();
                        }, 500);
                        return;
                    }
                }
            }

            let msgTitle = isCorrect ? "TERBAIK!" : "ALAMAK!";
            let msgDesc = isCorrect ? "Jawapan anda adalah tepat!" : `Jawapan betul ialah: ${rightAns}`;
            let bgStyle = isCorrect ? "bg-emerald-950 border-emerald-700" : "bg-red-950 border-red-900";

            footer.innerHTML = `
                <div class="${bgStyle} border-2 rounded-2xl p-4 flex items-center justify-between text-white animate-pop">
                    <div>
                        <h4 class="font-black text-sm">${msgTitle}</h4>
                        <p class="text-xs opacity-90">${msgDesc}</p>
                    </div>
                    <button onclick="generateNextQuestion()" class="bg-indigo-800 hover:bg-indigo-700 active:scale-95 text-xs text-white font-black px-4 py-2.5 rounded-xl border border-indigo-600 transition">
                        ${state.currentLanguage === 'bm' ? 'TERUSKAN' : 'CONTINUE'}
                    </button>
                </div>
            `;
        }

        function triggerParticles() {
            const app = document.getElementById('app');
            for (let i = 0; i < 15; i++) {
                let part = document.createElement('div');
                part.className = 'particle text-xl';
                part.innerText = Math.random() > 0.5 ? '⭐' : '✨';
                part.style.left = `${Math.floor(Math.random() * 80) + 10}%`;
                part.style.top = '30%';
                app.appendChild(part);
                setTimeout(() => part.remove(), 1500);
            }
        }

        function quitGameplay() {
            SoundManager.playClick();
            if (gameplayTimerInterval) clearInterval(gameplayTimerInterval);
            
            // Reset gameplay states & back to home view
            document.getElementById('screen-gameplay').classList.add('hidden');
            document.getElementById('app-header').classList.remove('hidden');
            document.getElementById('app-content').classList.remove('hidden');
            document.getElementById('app-nav').classList.remove('hidden');
            
            updateTopHUD();
            renderAdventureMap();
        }

        function finishGameplaySession() {
            if (gameplayTimerInterval) clearInterval(gameplayTimerInterval);
            SoundManager.playWin();

            let starsGained = 0;
            let coinsGained = 0;
            let xpGained = 0;
            let isVictory = true;

            if (activeGameMode === "adventure") {
                // If answers accuracy > 70% level is unlocked to next stage
                let acc = (correctCountThisSession / totalQuestionsCount);
                if (acc >= 0.70) {
                    starsGained = 50;
                    coinsGained = 30;
                    xpGained = 60;
                    
                    // Increment Adventure Map progress unlocked
                    if (currentLevelNum === state.adventureStage) {
                        state.adventureStage++;
                        state.dailyMissions.find(m => m.type === 'lvl').current++;
                    }
                } else {
                    isVictory = false;
                    starsGained = 10;
                    coinsGained = 5;
                    xpGained = 15;
                }
            } else if (activeGameMode === "speed") {
                // Gain based on total answers
                starsGained = correctCountThisSession * 5;
                coinsGained = correctCountThisSession * 3;
                xpGained = correctCountThisSession * 6;
            } else if (activeGameMode === "boss") {
                if (bossHPCurrent <= 0) {
                    starsGained = 150;
                    coinsGained = 100;
                    xpGained = 200;
                    
                    if (currentLevelNum === state.adventureStage) {
                        state.adventureStage++;
                        state.dailyMissions.find(m => m.type === 'lvl').current++;
                    }
                } else {
                    isVictory = false;
                    starsGained = 20;
                    coinsGained = 10;
                    xpGained = 30;
                }
            } else {
                // Casual
                starsGained = correctCountThisSession * 4;
                coinsGained = correctCountThisSession * 2;
                xpGained = correctCountThisSession * 5;
            }

            // Add resources to state
            state.stats.stars += starsGained;
            addCoins(coinsGained);
            addXP(xpGained);
            saveStateToStorage();

            // Quit gameplay view first
            document.getElementById('screen-gameplay').classList.add('hidden');
            document.getElementById('app-header').classList.remove('hidden');
            document.getElementById('app-content').classList.remove('hidden');
            document.getElementById('app-nav').classList.remove('hidden');

            updateTopHUD();
            renderAdventureMap();
            renderDailyMissions();

            // Show Session Complete Premium Modal
            let summaryTitle = isVictory ? "HEBAT! TUGASAN TAMAT!" : "CUBA LAGI!";
            let summaryDesc = state.currentLanguage === 'bm' ? 
                `Anda berjaya menjawab ${correctCountThisSession} betul!\n\nGanjaran:\n⭐ +${starsGained} Bintang\n💰 +${coinsGained} Syiling\n🚀 +${xpGained} XP` :
                `You answered ${correctCountThisSession} correctly!\n\nRewards:\n⭐ +${starsGained} Stars\n💰 +${coinsGained} Coins\n🚀 +${xpGained} XP`;

            showModal("<i class='fas fa-trophy text-playful-yellow animate-float'></i>", summaryTitle, summaryDesc);
        }

    </script>
</body>
</html>
