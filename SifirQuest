            ninja: { name: "Sifir Shinobi", emoji: "🥷", price: 150 },
            pirate: { name: "Captain Math", emoji: "🏴‍☠️", price: 200 },
            astronaut: { name: "Cosmo Kid", emoji: "🧑‍🚀", price: 300 },
