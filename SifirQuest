        // Parent Portal analytics drawer
        function renderParentStats() {
            document.getElementById('profile-name').innerText = state.user.name;
            document.getElementById('profile-age').innerText = state.user.age;
            document.getElementById('profile-year').innerText = state.user.year;
            document.getElementById('profile-code').innerText = state.user.code;

            // Simple conversions for stats
            let totalAnswers = state.stats.answeredTotal || 0;
            let correctAnswers = state.stats.correctTotal || 0;
            let accuracy = totalAnswers > 0 ? Math.round((correctAnswers / totalAnswers) * 100) : 0;
            
            // Format playtime
            let minutes = Math.floor(state.stats.playTimeTotal / 60);
            let seconds = state.stats.playTimeTotal % 60;
            let formatTime = minutes > 0 ? `${minutes}m ${seconds}s` : `${seconds}s`;

            document.getElementById('parent-stat-playtime').innerText = formatTime;
            document.getElementById('parent-stat-answered').innerText = totalAnswers;
            document.getElementById('parent-stat-accuracy').innerText = `${accuracy}%`;

            // Identify strongest sifir table
            let strongestTable = "-";
            let maxScore = 0;
            Object.keys(state.stats.tableScores).forEach(table => {
                let score = state.stats.tableScores[table].correct || 0;
                if (score > maxScore) {
                    maxScore = score;
                    strongestTable = `Sifir ${table}`;
                }
            });
            document.getElementById('parent-stat-strongest').innerText = strongestTable;

            // Render custom CSS/HTML charts
            let parentBarsContainer = document.getElementById('parent-progress-bars');
            parentBarsContainer.innerHTML = "";
            for (let i = 1; i <= 12; i++) {
                let tblObj = state.stats.tableScores[i] || { correct: 0, total: 0 };
                let tblPercent = tblObj.total > 0 ? Math.round((tblObj.correct / tblObj.total) * 100) : 0;
                
                parentBarsContainer.innerHTML += `
                    <div class="flex flex-col items-center h-full justify-end flex-1 group relative cursor-pointer">
                        <!-- Tooltip inside parent portal -->
                        <span class="absolute bottom-16 bg-indigo-900 border border-indigo-700 text-white font-bold text-[9px] px-1 py-0.5 rounded opacity-0 group-hover:opacity-100 transition">${tblPercent}%</span>
                        <div class="bg-indigo-900 w-2.5 h-full rounded-full overflow-hidden flex flex-col justify-end">
                            <div class="bg-gradient-to-t from-emerald-500 to-green-400 w-full" style="height: ${tblPercent}%;"></div>
                        </div>
                        <span class="text-[8px] font-black text-indigo-300 mt-1">${i}</span>
                    </div>
                `;
            }
        }

        function checkAndOpenCertificate() {
