        function generateNextQuestion() {
            currentQuestionIdx++;
            
            if (activeGameMode !== "speed" && activeGameMode !== "boss" && currentQuestionIdx > totalQuestionsCount) {
                finishGameplaySession();
                return;
            }

            document.getElementById('gameplay-progress-text').innerText = activeGameMode === "speed" ? `Dijawab: ${correctCountThisSession}` : `Q ${currentQuestionIdx}/${totalQuestionsCount}`;

            // Determine what multiplication table base to practice
            let tableBase = currentLevelNum;
            if (activeGameMode === "speed" || activeGameMode === "boss") {
                tableBase = Math.floor(Math.random() * 12) + 1;
            }

            let multiplier = Math.floor(Math.random() * 12) + 1;
            let product = tableBase * multiplier;

            // Prevent consecutive duplication
            if (currentQuestionObj && currentQuestionObj.product === product && currentQuestionObj.base === tableBase) {
                multiplier = (multiplier % 12) + 1;
                product = tableBase * multiplier;
            }

            currentQuestionObj = {
                base: tableBase,
                multiplier: multiplier,
                product: product
            };

            // Select random gameplay question type (1: MCQ, 2: Drag, 3: Fill, 4: Match, 5: Balloon, 6: Memory)
            // If activeGameMode is boss, use multiple choice & input keys to make it epic and quick!
            let questionType = Math.floor(Math.random() * 6) + 1;
            if (activeGameMode === "boss") {
                questionType = Math.random() > 0.5 ? 1 : 3; // MCQ or Fill blank
            }

            renderGameplayWorkspace(questionType);
        }

