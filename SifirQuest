            SoundManager.playClick();
            activeRewardTab = tab;
            if (tab === 'shop') {
                document.getElementById('reward-tab-shop').className = "flex-1 bg-indigo-800 text-white font-black text-xs py-2.5 rounded-xl transition text-center";
                document.getElementById('reward-tab-achieve').className = "flex-1 text-indigo-300 font-bold text-xs py-2.5 rounded-xl transition text-center";
