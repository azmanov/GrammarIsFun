                        </div>
                        ${isUnlocked ? 
                            `<button onclick="setActiveTheme('${key}')" class="w-full ${isActive ? 'bg-indigo-950 border-indigo-800 text-indigo-500' : 'bg-emerald-600 hover:bg-emerald-700'} text-white text-[10px] font-black py-1.5 rounded-xl transition">${isActive ? 'ACTIVE' : 'USE THEME'}</button>` :
